[sub_resource type="GDScript" id=8]
script/source = "extends Control

onready var clickSoundPlayer = $ClickSoundPlayer

onready var lbl_master_value = $GridContainer/lbl_Master_value
onready var lbl_music_value = $GridContainer/lbl_Music_value
onready var lbl_sound_value = $GridContainer/lbl_Sound_value

func _ready():
	hide()


func _process(delta):
	lbl_master_value.text = str(AudioManager.master_volume)
	lbl_music_value.text = str(AudioManager.music_volume)
	lbl_sound_value.text = str(AudioManager.sound_volume)


func _on_btn_clear_save_pressed():
	Globals.high_score = 0
	Globals.save()
	clickSoundPlayer.play()


func _on_btn_master_minus_pressed():
	AudioManager.master_volume -= 5
	clickSoundPlayer.play()


func _on_btn_master_plus_pressed():
	AudioManager.master_volume += 5
	clickSoundPlayer.play()


func _on_btn_music_minus_pressed():
	AudioManager.music_volume -= 5
	clickSoundPlayer.play()


func _on_btn_music_plus_pressed():
	AudioManager.music_volume += 5
	clickSoundPlayer.play()


func _on_btn_sound_minus_pressed():
	AudioManager.sound_volume -= 5
	clickSoundPlayer.play()


func _on_btn_sound_plus_pressed():
	AudioManager.sound_volume += 5
	clickSoundPlayer.play()


func _on_btn_fullscreen_toggle_pressed():
	OS.window_fullscreen = $HBoxContainer/btn_fullscreen_toggle.pressed
	clickSoundPlayer.play()
"

