[sub_resource type="GDScript" id=5]
script/source = "extends Path2D

export(Vector2) var mouse_offset

onready var path_follow = $PathFollow2D


func _process(delta):
	var offset = curve.get_closest_offset(get_local_mouse_position() + mouse_offset)
	path_follow.offset = offset
"

