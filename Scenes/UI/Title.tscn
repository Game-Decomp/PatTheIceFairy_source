[sub_resource type="GDScript" id=1]
script/source = "extends Node2D

var cirno_scene = preload(\"res://Scenes/Game/Cirno.tscn\")

const default_spawn_range = Rect2(150, 500, 1150, 200)
var spawn_range = default_spawn_range

var total = 1

func _ready():
	randomize()


func spawn_cirno():
	var cirno = cirno_scene.instance()
	cirno.global_position = Vector2(
		rand_range(spawn_range.position.x, spawn_range.end.x),
		rand_range(spawn_range.position.y, spawn_range.end.y)
	)
	cirno.is_infinite_headpat = true
	$YSort.add_child(cirno)


func _on_Timer_timeout():
	if total < 9:
		spawn_cirno()
		total += 1
	
	$SpawnTimer.start(rand_range(5, 10))


func _on_DespawnTimer_timeout():
	if total > 0:
		var cirno = $YSort.get_child(randi() % total)
		if not cirno.state in [cirno.SPAWN, cirno.ESCAPE]:
			cirno.state = 4
			total -= 1
	
	$DespawnTimer.start(rand_range(6, 12))


func _on_InitTimer_timeout():
	var cirno = cirno_scene.instance()
	cirno.global_position = Vector2(720, 650)
	cirno.is_infinite_headpat = true
	$YSort.add_child(cirno)
"

[sub_resource type="GDScript" id=2]
