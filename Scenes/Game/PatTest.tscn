[sub_resource type="GDScript" id=4]
script/source = "extends TextureProgress

signal fever_start
signal fever_end

onready var anim_player = $AnimationPlayer
onready var lbl_fever = $Label
onready var timer = $Timer

var fever_mode = false
var proxy_value = 0

func _ready():
	set_process(false)
	lbl_fever.hide()
	tint_over = Color(\"ffffff\")
	
	match(Globals.difficulty):
		Globals.EASY:
			max_value = 39
		Globals.NORMAL:
			max_value = 69
		Globals.HARD:
			max_value = 99
	
	timer.start(3)


func _process(delta):
	proxy_value -= max_value/18 * delta
	value = proxy_value
	
	tint_over.h += delta
	
	if value == 0:
		fever_mode = false
		emit_signal(\"fever_end\")
		set_process(false)
		lbl_fever.hide()
		tint_over = Color(\"ffffff\")
		$AnimationPlayer3.play(\"fever_Reset\")
		MusicManager.play_main_music()


func add_score():
	if not fever_mode:
		proxy_value += 1
		value = proxy_value
		
		timer.wait_time = range_lerp(value, min_value, max_value, 9, 0.4)
		timer.start()
		
		anim_player.play(\"beat\")
		
		if value == max_value:
			fever_mode = true
			lbl_fever.show()
			get_tree().paused = true
			emit_signal(\"fever_start\")
			$AnimationPlayer2.play(\"actuvate\")


func start_fever():
	set_process(true)
	get_tree().paused = false
	tint_over = Color(\"ffa2a2\")
	$AnimationPlayer3.play(\"fever\")
	MusicManager.play_fever_music()


func _on_Timer_timeout():
	if fever_mode:
		timer.wait_time = 0.4
	else:
		timer.wait_time = range_lerp(value, min_value, max_value, 9, 0.4)
	
	timer.start()
	anim_player.play(\"beat\")
"

