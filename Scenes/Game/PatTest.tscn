[sub_resource type="GDScript" id=1]
resource_name = "game_end"
script/source = "extends Node

var total = 1
var cirno_scene = preload(\"res://Scenes/Game/Cirno.tscn\")

const default_spawn_range = Rect2(150, 300, 1150, 700)
var spawn_range = default_spawn_range

var time_left = 99
var score = 0 setget set_score

onready var lbl_score = $CanvasLayer/Control/MarginContainer/ScoreLabel
onready var lbl_time = $CanvasLayer/Control/MarginContainer/TimeLabel
onready var fever_progress = $CanvasLayer/Control/MarginContainer/FeverProgress

func _ready():
	get_tree().paused = true
	$AnimationPlayer.play(\"Start Sequence\")


func _process(delta):
	if Input.is_action_just_pressed(\"escape\"):
		SceneManager.load_scene(SceneManager.TITLE)
	if Input.is_action_just_pressed(\"number 9\"):
		if time_left > 90:
			fever_progress.proxy_value = fever_progress.max_value - 1
			fever_progress.value = fever_progress.max_value - 1
			time_left = 25
			
			while total < 9:
				spawn_cirno()
				total += 1
		elif time_left > 1:
			time_left = 1


func _on_Cirno_Escaped():
	self.score += 900
	fever_progress.add_score()
	
	yield(get_tree().create_timer(0.1),\"timeout\")
	
	spawn_cirno()


func spawn_cirno():
	var cirno = cirno_scene.instance()
	cirno.global_position = Vector2(
		rand_range(spawn_range.position.x, spawn_range.end.x),
		rand_range(spawn_range.position.y, spawn_range.end.y)
	)
	cirno.connect(\"escaped\", self, \"_on_Cirno_Escaped\")
	cirno.connect(\"add_score\", self, \"_on_Cirno_add_score\")
	cirno.connect(\"pet_active\", $Camera2D, \"_on_Cirno_pat_active\")
	cirno.connect(\"pet_stop\", $Camera2D, \"_on_Cirno_pat_stop\")
	$YSort.add_child(cirno)


func _on_Timer_timeout():
	if total < 9:
		total += 1
		spawn_cirno()


func _on_Cirno_add_score(additional_score):
	self.score += additional_score


func set_score(val):
	score = val
	
	var display_number = str(round(score))
	
	for i in range(display_number.length()-3, 0, -3):
		display_number = display_number.insert(i, \",\")
	
	lbl_score.text = display_number


func _on_FeverProgress_fever_start():
	Globals.ending_unlocked = true
	
	spawn_range = Rect2(600, 600, 200, 120)
	
	for c in get_tree().get_nodes_in_group(\"cirno\"):
		c.is_must_escape = true


func _on_FeverProgress_fever_end():
	spawn_range = default_spawn_range


func _on_GameTimer_timeout():
	time_left -= 1
	lbl_time.text = \"Time : %s\" % str(time_left)
	
	if time_left == 0:
		Globals.score = score
		
		get_tree().paused = true
		$AnimationPlayer.play(\"end_sequence\")


func _on_btn_title_pressed():
	SceneManager.load_scene(SceneManager.TITLE)
	$ClickSound.play()


func game_start():
	get_tree().paused = false
	spawn_cirno()
	$SpawnTimer.start()
	$GameTimer.start()


func game_end():
	SceneManager.load_scene(SceneManager.SCORE)
"

