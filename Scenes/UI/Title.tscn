[sub_resource type="GDScript" id=5]
script/source = "extends VBoxContainer

onready var clickSoundPlayer = $ClickSoundPlayer
onready var btn_easy = $HBoxContainer/btn_easy
onready var btn_normal = $HBoxContainer/btn_normal
onready var btn_hard = $HBoxContainer/btn_hard
onready var tooltip = $lbl_tooltip

func _ready():
	hide()


func _process(delta):
	var message = \"%s : Fever mode requires %s Headpats\"
	
	tooltip.modulate = Color(1, 1, 1, 1)
	
	if btn_easy.is_hovered():
		tooltip.text = message % [\"Easy\", \"39\"]
	elif btn_normal.is_hovered():
		tooltip.text = message % [\"Normal\", \"69\"]
	elif btn_hard.is_hovered():
		tooltip.text = message % [\"Hard\", \"99\"]
	else:
		tooltip.modulate = Color(1, 1, 1, 0)


func _on_btn_easy_pressed():
	Globals.difficulty = Globals.EASY
	clickSoundPlayer.play()
	load_game()


func _on_btn_normal_pressed():
	Globals.difficulty = Globals.NORMAL
	clickSoundPlayer.play()
	load_game()


func _on_btn_hard_pressed():
	Globals.difficulty = Globals.HARD
	clickSoundPlayer.play()
	load_game()


func load_game():
	get_tree().paused = true
	SceneManager.load_scene(SceneManager.GAME)
"

