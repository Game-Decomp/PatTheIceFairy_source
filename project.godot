; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

[application]

config/name="Pat The Ice Fairy"
run/main_scene="res://Scenes/UI/Splash.tscn"
boot_splash/image="res://icon.png"
boot_splash/fullsize=false
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"

[audio]

output_latency.web=15

[autoload]

SceneManager="*res://Scenes/AutoLoad/SceneManager.tscn"
Globals="*res://Scenes/AutoLoad/Globals.tscn"
MusicManager="*res://Scenes/AutoLoad/MusicManager.tscn"
AudioManager="*res://Scenes/AutoLoad/AudioManager.tscn"

[display]

window/size/width=1440
window/size/height=1080
window/size/test_width=640
window/size/test_height=480
window/dpi/allow_hidpi=true
window/stretch/mode="2d"
window/stretch/aspect="keep_height"

[editor]

convert_text_resources_to_binary_on_export=true

[input]

mouse_right={
"deadzone": 0.5,
"events": [ Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":0,"alt":false,"shift":false,"control":false,"meta":false,"command":false,"button_mask":0,"position":Vector2( 0, 0 ),"global_position":Vector2( 0, 0 ),"factor":1.0,"button_index":2,"canceled":false,"pressed":false,"doubleclick":false,"script":null)
 ]
}
escape={
"deadzone": 0.5,
"events": [ Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"alt":false,"shift":false,"control":false,"meta":false,"command":false,"pressed":false,"scancode":16777217,"physical_scancode":0,"unicode":0,"echo":false,"script":null)
 ]
}
