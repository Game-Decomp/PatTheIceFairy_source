[sub_resource type="GDScript" id=1]
script/source = "extends Node

func _ready():
	SceneManager.connect(\"request_scene_load\", self, \"_on_load_scene\")
	
	SceneManager.load_scene(SceneManager.INTRO)


func _on_load_scene(path):
	$Border/HBoxContainer/Transition.fade_in()
	yield(get_tree().create_timer(0.5),\"timeout\")
	
	$Border/HBoxContainer/Transition/LoadingScreen.load_scene(path)


func _on_LoadingScreen_load_complete(resource:PackedScene):
	var scene = resource.instance()
	
	for child in $Viewport.get_children():
		$Viewport.remove_child(child)
	
	$Viewport.add_child(scene)
	$Border/HBoxContainer/Transition.fade_out()
	
	yield(get_tree().create_timer(0.5), \"timeout\")
	
	SceneManager.loading = false
"

[sub_resource type="Shader" id=2]
code = "shader_type canvas_item;

uniform float speed : hint_range(0, 1);

void fragment(){
  COLOR = texture(TEXTURE, UV + TIME * speed);
}"

